node {
    def ec2IP = '3.0.18.208'
    def imageTag = "${env.BUILD_NUMBER}"
    def imageName = "ardfordev/react-app:${imageTag}"

    try {
        stage('Checkout') {
            checkout scm
        }

        stage('Build & Test') {
            docker.image('node:lts-bookworm-slim').inside('-p 3000:3000 --network host') {
                withEnv(['CI=true']) {
                    stage('Install Dependencies') {
                        sh 'npm install'
                    }

                    stage('Lint Code') {
                        sh 'npm run lint'
                    }

                    stage('Run Tests') {
                        sh 'npm test'
                    }

                    stage('Build Application') {
                        sh 'npm run build'
                    }
                }
            }
        }

        stage('Build Docker Image') {
            sh "docker build -t ${imageName} ."
        }

        stage('Push Docker Image') {
            withCredentials([usernamePassword(credentialsId: 'docker', usernameVariable: 'DOCKER_USERNAME', passwordVariable: 'DOCKER_PASSWORD')]) {
                sh """
                    echo $DOCKER_PASSWORD | docker login -u $DOCKER_USERNAME --password-stdin
                    docker push ${imageName}
                    docker logout
                """
            }
        }

        stage('Deploy to EC2') {
            sshagent(['ec2-react-app']) {
                sh """
                    echo "Uploading Docker Compose and Nginx config..."
                    scp -o StrictHostKeyChecking=no docker-compose.yml nginx.conf ec2-user@${ec2IP}:/home/ec2-user/

                    echo "Deploying to EC2..."
                    ssh -o StrictHostKeyChecking=no ec2-user@${ec2IP} << EOF
                        export IMAGE_TAG=${imageTag}
                        docker compose pull
                        docker compose down
                        docker compose up -d --remove-orphans
                        docker system prune -f
                    EOF
                """
            }
        }
    } catch (Exception e) {
        currentBuild.result = "FAILURE"
        throw e
    } finally {
        sh 'docker image prune -f'
        echo "Build finished with status: ${currentBuild.result ?: 'SUCCESS'}"
    }
}
