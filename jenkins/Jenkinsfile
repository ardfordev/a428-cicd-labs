node {
    def app
    def imageRegistry = 'your-docker-registry'  // Replace with your Docker registry
    def imageName = 'vite-react-app'
    def imageTag = "${BUILD_NUMBER}"
    def ec2IP = 'your-ec2-ip'  // Replace with your EC2 IP

    try {
        stage('Checkout') {
            checkout scm
        }

        docker.image('node:lts-bookworm-slim').inside('-p 3000:3000 --network host') {
            withEnv(['CI=true']) {
                stage('Install') {
                    sh 'npm install'
                }

                stage('Lint') {
                    sh 'npm run lint'
                }

                stage('Test') {
                    sh 'npm test'
                }

                stage('Build') {
                    sh 'npm run build'
                }
            }
        }

        stage('Build Docker Image') {
            app = docker.build("${imageRegistry}/${imageName}:${imageTag}")
        }

        stage('Push Docker Image') {
            withCredentials([usernamePassword(credentialsId: 'docker-login', passwordVariable: 'PASS', usernameVariable: 'USER')]) {
                sh "echo $PASS | docker login -u $USER --password-stdin"
                app.push()
            }
        }

        stage('Deploy to EC2') {
            sshagent(['ec2-ssh-key']) {
                // Copy docker-compose and nginx config
                sh """
                    scp -o StrictHostKeyChecking=no docker-compose.yml nginx.conf ubuntu@${ec2IP}:/home/ubuntu/
                    ssh -o StrictHostKeyChecking=no ubuntu@${ec2IP} '
                        export IMAGE_TAG=${imageTag}
                        docker compose down
                        docker compose up -d
                    '
                """
            }
        }
    } catch (e) {
        currentBuild.result = "FAILED"
        throw e
    } finally {
        // Cleanup
        sh 'docker image prune -f'
        
        // Notify about build status
        def buildStatus = currentBuild.result ?: 'SUCCESS'
        echo "Build finished with status: ${buildStatus}"
    }
}