node {
    def app
    def ec2IP = '3.0.18.208'
    def imageTag = "latest"

    try {
        stage('Checkout') {
            checkout scm
        }

        docker.image('node:lts-bookworm-slim').inside('-p 3000:3000 --network host') {
            withEnv(['CI=true']) {
                stage('Install') {
                    sh 'npm install'
                }

                stage('Lint') {
                    sh 'npm run lint'
                }

                stage('Test') {
                    sh 'npm test'
                }

                stage('Build') {
                    sh 'npm run build'
                }
            }
        }

        withCredentials([usernamePassword(credentialsId: 'docker', usernameVariable: 'DOCKERHUB_CREDENTIALS_USR', passwordVariable: 'DOCKERHUB_CREDENTIALS_PSW')]) {
            try {
                stage('Build Docker Image') {
                    sh "docker build -t ardfordev/react-app:${imageTag} ."
                }
                stage('Login DockerHub') {
                    sh 'echo $DOCKERHUB_CREDENTIALS_PSW | docker login -u $DOCKERHUB_CREDENTIALS_USR --password-stdin'
                }

                stage('Push Docker Image') {
                    sh "docker push ardfordev/react-app:${imageTag}"
                }
            } finally {
                sh 'docker logout'
            }
        }

        stage('Deploy to EC2') {
            sshagent(['ec2-react-app']) {
                sh """
                    scp -o StrictHostKeyChecking=no docker-compose.yml nginx.conf ubuntu@${ec2IP}:/home/ubuntu/
                    ssh -o StrictHostKeyChecking=no ubuntu@${ec2IP} '
                        export IMAGE_TAG=${imageTag}
                        docker compose pull
                        docker compose up -d --remove-orphans
                        docker system prune -f
                    '
                """
            }
        }
    } catch (e) {
        currentBuild.result = "FAILED"
        throw e
    } finally {
        sh 'docker image prune -f'
        def buildStatus = currentBuild.result ?: 'SUCCESS'
        echo "Build finished with status: ${buildStatus}"
    }
}
