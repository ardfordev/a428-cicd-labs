node {
    def app
    def SSH_KEY = './react-app.pem' // ID of your EC2 keypair credentials in Jenkins
    def EC2_USER = 'ec2-user'     // or 'ec2-user' for Amazon Linux
    def EC2_IP = 'ec2-user@ec2-3-0-18-208.ap-southeast-1.compute.amazonaws.com'  // Your EC2 instance IP

    try {
        stage('Checkout') {
            checkout scm
        }

        docker.image('node:lts-bookworm-slim').inside('-p 3000:3000') {
            withEnv(['CI=true']) {
                stage('Setup') {
                    sh 'chmod +x jenkins/scripts/test.sh'
                    sh 'chmod +x jenkins/scripts/deliver.sh'
                    sh 'chmod +x jenkins/scripts/kill.sh'
                }

                stage('Install') {
                    sh 'npm install'
                }

                stage('Lint') {
                    sh 'npm run lint'
                }

                stage('Test') {
                    sh './jenkins/scripts/test.sh'
                }

                stage('Build') {
                    sh 'npm run build'
                }
            }
        }
        
        // Preview stage outside of docker container
        stage('Preview') {
            // Start preview server
            sh 'npm run preview -- --port 3000 &'
            echo 'Preview started at http://localhost:3000'
            
            // Wait for 1 minute
            echo 'Waiting for 1 minute...'
            sleep(time: 60, unit: 'SECONDS')
            
            // Kill preview server
            sh '''
                PID=$(lsof -t -i:3000)
                if [ ! -z "$PID" ]; then
                    kill $PID
                fi
            '''
            echo 'Preview server stopped'
        }

        stage('Manual Approval') {
            input message: 'Lanjutkan ke tahap Deploy?', ok: 'Proceed'
        }

        stage('Deploy') {
            sshagent([SSH_KEY]) {
                // Create deployment script
                sh '''
                    echo '#!/bin/bash
                    cd ~/app
                    pm2 stop all || true
                    rm -rf dist/*
                    mv dist_new/* dist/
                    pm2 start npm --name "react-app" -- start
                    ' > deploy.sh
                '''
                
                // Create directory if not exists
                sh "ssh -o StrictHostKeyChecking=no ${EC2_USER}@${EC2_IP} 'mkdir -p ~/app/dist'"
                
                // Copy build files
                sh "scp -r dist/* ${EC2_USER}@${EC2_IP}:~/app/dist_new/"
                
                // Copy and execute deployment script
                sh """
                    scp deploy.sh ${EC2_USER}@${EC2_IP}:~/app/
                    ssh ${EC2_USER}@${EC2_IP} 'chmod +x ~/app/deploy.sh && ~/app/deploy.sh'
                """
            }
        }
    } catch (e) {
        currentBuild.result = "FAILED"
        throw e
    } finally {
        notifyBuildStatus()
    }
}

def notifyBuildStatus() {
    if (currentBuild.result == "FAILED") {
        echo "Build failed - send notification if needed"
    } else {
        echo "Build successful - send notification if needed"
    }
}