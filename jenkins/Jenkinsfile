node {
    def app

    try {
        stage('Checkout') {
            // Automatically checks out from version control
            checkout scm
        }

        docker.image('node:iron-slim').inside('-p 3000:3000') {
            withEnv(['CI=true']) {
                stage('Setup') {
                    // Add execute permissions to scripts
                    sh 'chmod +x jenkins/scripts/test.sh'
                    sh 'chmod +x jenkins/scripts/deliver.sh'
                    sh 'chmod +x jenkins/scripts/kill.sh'
                }

                stage('Install') {
                    sh 'npm install'
                }

                stage('Lint') {
                    sh 'npm run lint'
                }

                stage('Test') {
                    sh './jenkins/scripts/test.sh'
                }

                stage('Build') {
                    sh './jenkins/scripts/deliver.sh'
                    input message: 'Finished reviewing the preview build? (Click "Proceed" to continue)'
                    sh './jenkins/scripts/kill.sh'
                }
            }
        }
    } catch (e) {
        // If there was an exception thrown, the build failed
        currentBuild.result = "FAILED"
        throw e
    } finally {
        // Success or failure, always send notifications
        notifyBuildStatus()
    }
}

def notifyBuildStatus() {
    // Logic for notifications can be added here
    if (currentBuild.result == "FAILED") {
        echo "Build failed - send notification if needed"
    } else {
        echo "Build successful - send notification if needed"
    }
}